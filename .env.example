# GDGC Art Studio Website - Environment Configuration Template
# Copy this file to .env before starting the server

# Server Port
PORT=5001

# JWT Secret and Token Lifetime
JWT_SECRET=gdgc-art-studio-super-secret-jwt-key-2026-production-ready
JWT_EXPIRES_IN=24h

# SQLite Database File Path
DB_PATH=./data/art_studio.db

# Studio Wall Mural Rate (in INR ₹ per sq ft from seedData)
WALL_PAINTING_RATE_PER_SQFT=150.00

# Currency
CURRENCY=INR
CURRENCY_SYMBOL=₹

# Frontend API Base URL (used by Vite frontend during dev/build)
VITE_API_BASE_URL=http://localhost:5001/api
